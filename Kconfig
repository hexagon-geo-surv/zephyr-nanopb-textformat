config NANOPB_TEXTFORMAT
	bool "Protobuf text format for nanopb messages"
	depends on NANOPB
	# A hard requirement, not a preference. The printer escapes non-printable
	# bytes as three-digit octal, and CBPRINTF_NANO has no %o conversion at all
	# -- it emits "\12" where "\012" is required, which re-parses wrongly
	# whenever the next byte is a digit. Depending on the choice member is the
	# only way to say this in Kconfig; it cannot be selected.
	depends on CBPRINTF_COMPLETE
	help
	  Parse a subset of the protobuf text format
	  (https://protobuf.dev/reference/protobuf/textformat-spec/) directly
	  into a nanopb-generated struct, and print such a struct back out.

	  Intended for hand-typed input, e.g. a Zephyr shell command:

	    cfg set delay: 100, threshold: 500

	  Everything accepted is valid text format that protobuf's own parser
	  accepts. See docs/dialect.md for the exact subset.

if NANOPB_TEXTFORMAT

config NANOPB_TEXTFORMAT_FLOAT
	bool "Parse and print float and double fields"
	default y
	depends on !MINIMAL_LIBC
	# Sound because the whole module already depends on CBPRINTF_COMPLETE,
	# which is what CBPRINTF_FP_SUPPORT itself requires.
	select CBPRINTF_FP_SUPPORT
	help
	  Enable float/double support. Parsing needs strtod(), which the minimal
	  libc does not provide, hence the dependency. Printing needs
	  CBPRINTF_FP_SUPPORT, which this selects.

	  When disabled, a float or double field reports PB_TF_ERR_NO_FLOAT in
	  both directions rather than failing the build, and neither strtod() nor
	  floating-point formatting is referenced, so neither is linked.

	  Measured on mps2/an385 at -Os, this saves 8 KB of flash in the sample
	  and 12 KB in the test application, and no RAM in either. How much you
	  get back depends on whether something else in your image already
	  formats floating point.

	  Note: messages with genuine 64-bit fields additionally need
	  CBPRINTF_FULL_INTEGRAL, which is the Kconfig default. Narrower fields do
	  not -- the printer uses width-correct conversions (PRIu32 and friends),
	  so only fields wider than 32 bits depend on it, and such a field reports
	  PB_TF_ERR_UNSUPPORTED if it is unavailable.

config NANOPB_TEXTFORMAT_MAX_DEPTH
	int "Maximum submessage nesting depth"
	default 8
	range 1 32
	help
	  Submessage nesting limit for both the parser and the printer.
	  Exceeding it reports PB_TF_ERR_DEPTH.

	  The parser is iterative: nesting costs one entry in a fixed array
	  inside a single stack frame, not a frame per level. Measured on
	  Cortex-M3 at -Os, pb_tf_parse() costs 132 bytes plus 20 per level, so
	  the default 8 is 296 bytes and the maximum 32 is 776 -- worth knowing
	  against CONFIG_SHELL_STACK_SIZE, which defaults to 2048. Raising this
	  is linear and visible in one -fstack-usage line.

module = NANOPB_TEXTFORMAT
module-str = nanopb_textformat
source "subsys/logging/Kconfig.template.log_config"

endif # NANOPB_TEXTFORMAT
