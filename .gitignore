# West workspace fetched into the repo (see docs: `rip ws` to reset)
/ws/zephyr/
/ws/modules/
/ws/.west/
/ws/build*/
/ws/twister-out*/

# Local pyenv/virtualenv selection. Whatever provides `west` is the developer's
# own choice, and a committed name breaks every clone that does not have it.
.python-version

# Build artefacts
build*/
twister-out*/
*.pyc
__pycache__/
.DS_Store
